
# ──────────────────────────────────────────────
# CAREERX — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to source control.
# ──────────────────────────────────────────────

# IBM watsonx.ai credentials
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model IDs (defaults shown)
GRANITE_LLM_MODEL=ibm/granite-13b-instruct-v2
GRANITE_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr

# ChromaDB persistence directory (relative to project root)
CHROMA_PERSIST_DIR=./data/chroma_db

# Knowledge base JSON path
KB_DATA_PATH=./data/knowledge_base.json

# Application settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# Safety disclaimer shown to users
DISCLAIMER_TEXT="Career recommendations are AI-generated guidance only and do not guarantee employment outcomes."
